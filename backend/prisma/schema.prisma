generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  id            Int      @id @default(1)
  homeValue     Float    @default(0)
  location      String   @default("")
  aiVisionModel String?
  aiTextModel   String?
  updatedAt     DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  name            String
  category        String
  status          String   @default("planned")
  estimatedCost   Float    @default(0)
  actualCost      Float    @default(0)
  roiBenchmark    Float    @default(0)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  notes           String   @default("")
  priority        String   @default("medium")
  tasks           Task[]
  contractors     Contractor[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contractor {
  id        String    @id @default(cuid())
  name      String
  company   String    @default("")
  trade     String    @default("")
  phone     String    @default("")
  email     String    @default("")
  website   String    @default("")
  notes     String    @default("")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RoiBenchmark {
  id          String  @id @default(cuid())
  category    String  @unique
  label       String
  roiPercent  Float
  avgCost     Float
  notes       String  @default("")
}

model Task {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  scheduledDate DateTime?
  status        String   @default("pending")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HomeValueSnapshot {
  id        String   @id @default(cuid())
  value     Float
  note      String   @default("")
  createdAt DateTime @default(now())
}

model ElecScenario {
  id               Int      @id @default(1)
  panelAmps        Int      @default(200)
  sqft             Int      @default(0)
  smallAppCircuits Int      @default(2)
  laundry          Boolean  @default(true)
  loads            Json     @default("[]")
  subPanels        Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

model ManualJScenario {
  id          Int      @id @default(1)
  mode        String   @default("whole")
  climate     Json     @default("{}")
  wholeZone   Json     @default("{}")
  zones       Json     @default("[]")
  step        Int      @default(0)
  currentZone Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Detector {
  id            String    @id @default(cuid())
  type          String    @default("smoke")
  location      String
  installedAt   DateTime?
  replaceByDate DateTime?
  batteryType   String    @default("")
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model NameplateImage {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  imageData     String
  mimeType      String   @default("image/jpeg")
  extractedData Json?
  modelUsed     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType, entityId])
}

// One row per floor. `data` holds geometry in inches:
// { nodes, walls, rooms, openings } — see frontend/src/floorplan/geometry.js
// `north` is degrees clockwise from plan-up; the UI keeps it identical across floors.
model FloorPlan {
  id        String   @id @default(cuid())
  name      String
  level     Int      @default(0)
  ceilingHt Float    @default(9)
  north     Float    @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Wi-Fi survey (docs/wifi-survey-plan.md). A survey is one pass through the
// house; each point is one measurement spot. A point doubles as the job the
// laptop agent picks up: status queued → running → done | failed | cancelled | expired.
model Survey {
  id        String        @id @default(cuid())
  name      String
  type      String        @default("baseline") // baseline | ap_on_a_stick | validation
  notes     String        @default("")
  meta      Json          @default("{}")       // test AP, agent/laptop info, iperf server…
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  points    SurveyPoint[]
  analyses  SurveyAnalysis[]
}

// Output of the wifi_survey analysis service: fitted propagation model per
// band, AP/radio mapping and heatmap grids. Only the latest few are kept.
model SurveyAnalysis {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  kind      String   @default("analysis") // "analysis" (model + heatmaps) | "plan" (AP placement)
  result    Json
  createdAt DateTime @default(now())

  @@index([surveyId, createdAt])
}

model SurveyPoint {
  id         String    @id @default(cuid())
  surveyId   String
  survey     Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  floorId    String
  roomId     String?
  label      String              // e.g. "kitchen-02"; suggested points keep their label
  x          Float               // inches, floor plan coordinates
  y          Float
  status     String    @default("queued")
  agentId    String?
  progress   Json?               // { step, message } while running
  record     Json?               // spec §2.2 point record from the agent
  error      String?
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  measuredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([surveyId])
  @@index([status, queuedAt])
}
